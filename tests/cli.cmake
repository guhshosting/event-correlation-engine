execute_process(COMMAND "${PROGRAM}" --version RESULT_VARIABLE code OUTPUT_VARIABLE output)
if(NOT code EQUAL 0 OR NOT output MATCHES "event-correlation-engine 1.0.0")
 message(FATAL_ERROR "version contract")
endif()
foreach(args IN ITEMS "recent;--max-events;0" "recent;--minutes;10081" "recent;--gap-seconds;301" "recent;--level;6" "around;--record-id;2" "recent;groups" "recent;--channel;\\\\server\\System" "recent;--channel;System;--channel;System" "recent;--minutes;999999999999999999999" "--unknown")
 execute_process(COMMAND "${PROGRAM}" ${args} RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
 if(NOT code EQUAL 2)
  message(FATAL_ERROR "usage contract failed: ${args}: ${code}")
 endif()
endforeach()
execute_process(COMMAND "${FIXTURES}" --json RESULT_VARIABLE code OUTPUT_VARIABLE fixture)
if(NOT code EQUAL 0)
 message(FATAL_ERROR "fixtures failed")
endif()
string(JSON schema GET "${fixture}" schema_version)
string(JSON status GET "${fixture}" acquisition status)
string(JSON missing TYPE "${fixture}" events 0 fields user_sid)
string(JSON message TYPE "${fixture}" events 0 message)
string(JSON windows GET "${fixture}" cluster_patterns 0 window_count)
string(JSON preceding GET "${fixture}" nearby preceding 0)
if(NOT schema STREQUAL "1.0" OR NOT status STREQUAL "partial" OR NOT missing STREQUAL "NULL" OR NOT message STREQUAL "NULL" OR NOT windows EQUAL 2 OR NOT preceding EQUAL 0)
 message(FATAL_ERROR "JSON schema/value contract")
endif()
